# Bu dosyayı VPS'te /opt/halisaha-be/.env olarak oluşturun.
# Gerçek değerlerle doldurun ve ASLA git'e commit etmeyin.

DB_URL=jdbc:postgresql://postgres:5432/halisaha
DB_USERNAME=halisaha_app
DB_PASSWORD=<guclu-bir-sifre>

SERVER_PORT=8080

# En az 256 bit (32+ karakter) rastgele bir değer kullanın:
# openssl rand -base64 48
JWT_SECRET=<rastgele-uzun-anahtar>
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend'in gerçek adresi (virgülle birden fazla origin eklenebilir)
CORS_ALLOWED_ORIGINS=https://app.halisahapro.tech

# docker-compose.prod.yml içindeki postgres servisi için (DB_USERNAME/DB_PASSWORD ile aynı olmalı)
POSTGRES_DB=halisaha
POSTGRES_USER=halisaha_app
POSTGRES_PASSWORD=<guclu-bir-sifre>
