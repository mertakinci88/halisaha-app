# Bu dosyayı EC2 sunucusunda /opt/halisaha-be/.env olarak oluşturun.
# Gerçek değerlerle doldurun ve ASLA git'e commit etmeyin.

# RDS endpoint'i: <db-instance>.xxxxxxxxxx.<region>.rds.amazonaws.com
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/halisaha
DB_USERNAME=halisaha_app
DB_PASSWORD=<guclu-bir-sifre>

SERVER_PORT=8080

# En az 256 bit (32+ karakter) rastgele bir değer kullanın:
# openssl rand -base64 48
JWT_SECRET=<rastgele-uzun-anahtar>
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend'in gerçek adresi (virgülle birden fazla origin eklenebilir)
CORS_ALLOWED_ORIGINS=http://localhost:5173
